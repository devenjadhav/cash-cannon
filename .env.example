# Airtable personal access token with data.records:read + data.records:write on the Haven base
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=appc9YSRmmAmLI37u
# Table IDs (defaults are the Haven base; override only if the base changes)
AIRTABLE_EVENTS_TABLE=tbl0BQWphHe0gWEIp
AIRTABLE_DISBURSEMENTS_TABLE=tblnDFHiIEvVPWcqH
# filterByFormula selecting eligible events
AIRTABLE_EVENTS_FILTER=AND({Status}='Active', NOT({_Is Test}), {HCB ID}!='')

# HCB API token with the transfers:write scope, belonging to a manager of the source org
HCB_API_TOKEN=...
# HCB org (slug or org_ id) that pays the grants
HCB_SOURCE_ORG=ysws-haven
PROGRAM_NAME=Haven

BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=change-me
PORT=8080
